# Exemplo de variáveis de ambiente do sistema VIP.
# Em desenvolvimento:  source env.example  (depois de preencher os valores)
# Em produção: configure as mesmas variáveis no painel da hospedagem / PHP-FPM.

export DB_HOST=localhost
export DB_PORT=3306
export DB_NAME=wrathsmp
export DB_USER=wrathsmp_user
export DB_PASS=senha_do_banco

export SITE_URL=https://seusite.com.br

export MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
export MP_WEBHOOK_SECRET=secret-gerado-no-painel
export MP_SANDBOX=true
export VIP_PRICE=8.00
export VIP_DAYS=30
export VIP_CURRENCY=BRL
export VIP_TITLE="VIP WrathSMP - 30 dias"

export VIP_PLUGIN_URL=http://127.0.0.1:8080/vip
export VIP_PLUGIN_TOKEN=token-longo-e-aleatorio
export VIP_PLUGIN_TIMEOUT=5

export VIP_CRON_TOKEN=outro-token-longo-e-aleatorio
